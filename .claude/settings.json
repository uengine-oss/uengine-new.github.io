{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/seo-page-changed.sh\"",
            "timeout": 30,
            "statusMessage": "SEO 메타 적용 중..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/seo-full-pass.sh\"",
            "timeout": 60,
            "statusMessage": "sitemap 갱신 중..."
          }
        ]
      }
    ]
  }
}
